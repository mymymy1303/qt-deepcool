# CH510 MESH DIGITAL (different vendor ID: 0x34D3, PID: 0x1100)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="34d3", ATTRS{idProduct}=="1100", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="34d3", ATTR{idProduct}=="1100", MODE="0666", GROUP="plugdev"
