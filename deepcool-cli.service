[Unit]
Description=DeepCool Digital Controller
Documentation=https://github.com/Nortank12/deepcool-digital-linux
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/deepcool-cli --interval 1000 --mode cpu --verbose
Restart=on-failure
RestartSec=5

# Run as root for device access (or use udev rules and run as specific user)
User=root

# Environment
Environment=QT_QPA_PLATFORM=offscreen

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepcool-cli

# Security hardening (optional)
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev
PrivateTmp=true

[Install]
WantedBy=multi-user.target
